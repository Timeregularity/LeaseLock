{
  "name": "leaselock-react-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "LeaseLock React frontend for concurrency-safe reservations",
  "author": "Timeregularity",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "server": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run build && npm run test:server",
    "test:server": "node --test server/app.test.js",
    "test:integration": "node --test server/auth/auth.integration.test.js server/bookings/bookings.integration.test.js server/events/events.integration.test.js server/holds/holds.integration.test.js server/waitlist/waitlist.integration.test.js",
    "test:frontend": "vitest run",
    "test:all": "npm run test:server && npm run test:frontend && npm run test:integration",
    "test:load": "node scripts/load-test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  }
}
